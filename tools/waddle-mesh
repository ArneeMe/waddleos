# --- Crypto ----------------------------------------------------------------------
# Plain Python, so the tool needs nothing installed: X25519 (RFC 7748),
# ChaCha20-Poly1305 (RFC 8439) and Ed25519 (RFC 8032). The same as
# lib/WaddleMesh/src/MeshCrypto.h and MeshRoster.h on the units.

_P = 2**255 - 19


def x25519(scalar, point):
    k = bytearray(scalar)
    k[0] &= 248
    k[31] = (k[31] & 127) | 64
    k = int.from_bytes(k, "little")
    x1 = int.from_bytes(point, "little") & ((1 << 255) - 1)
    x2, z2, x3, z3, swap = 1, 0, x1, 1, 0
    for t in reversed(range(255)):
        bit = (k >> t) & 1
        if swap ^ bit:
            x2, x3, z2, z3 = x3, x2, z3, z2
        swap = bit
        a, b, c, d = x2 + z2, x2 - z2, x3 + z3, x3 - z3
        aa, bb, da, cb = a * a % _P, b * b % _P, d * a % _P, c * b % _P
        e = aa - bb
        x3, z3 = (da + cb) ** 2 % _P, x1 * (da - cb) ** 2 % _P
        x2, z2 = aa * bb % _P, e * (aa + 121665 * e) % _P
    if swap:
        x2, z2 = x3, z3
    return (x2 * pow(z2, _P - 2, _P) % _P).to_bytes(32, "little")


def x25519_public(secret):
    return x25519(secret, (9).to_bytes(32, "little"))


def _chacha_block(key, counter, nonce):
    state = [0x61707865, 0x3320646E, 0x79622D32, 0x6B206574, *struct.unpack("<8I", key), counter,
             *struct.unpack("<3I", nonce)]
    w = list(state)

    def quarter(a, b, c, d):
        for x, y, z, r in ((a, b, d, 16), (c, d, b, 12), (a, b, d, 8), (c, d, b, 7)):
            w[x] = (w[x] + w[y]) & 0xFFFFFFFF
            v = w[z] ^ w[x]
            w[z] = ((v << r) | (v >> (32 - r))) & 0xFFFFFFFF

    for _ in range(10):
        for q in ((0, 4, 8, 12), (1, 5, 9, 13), (2, 6, 10, 14), (3, 7, 11, 15),
                  (0, 5, 10, 15), (1, 6, 11, 12), (2, 7, 8, 13), (3, 4, 9, 14)):
            quarter(*q)
    return struct.pack("<16I", *((w[i] + state[i]) & 0xFFFFFFFF for i in range(16)))


def _chacha(key, counter, nonce, data):
    out = bytearray()
    for i in range(0, len(data), 64):
        block = _chacha_block(key, counter + i // 64, nonce)
        out += bytes(a ^ b for a, b in zip(data[i:i + 64], block))
    return bytes(out)


def _poly1305(key, msg):
    r = int.from_bytes(key[:16], "little") & 0x0FFFFFFC0FFFFFFC0FFFFFFC0FFFFFFF
    acc = 0
    for i in range(0, len(msg), 16):
        acc = (acc + int.from_bytes(msg[i:i + 16] + b"\x01", "little")) * r % (2**130 - 5)
    return ((acc + int.from_bytes(key[16:], "little")) % 2**128).to_bytes(16, "little")


def _mac(key, nonce, aad, cipher):
    def pad(b):
        return b"\x00" * (-len(b) % 16)
    data = aad + pad(aad) + cipher + pad(cipher) + struct.pack("<QQ", len(aad), len(cipher))
    return _poly1305(_chacha_block(key, 0, nonce)[:32], data)


def aead_seal(key, nonce, plain, aad=b""):
    cipher = _chacha(key, 1, nonce, plain)
    return cipher + _mac(key, nonce, aad, cipher)


def aead_open(key, nonce, sealed, aad=b""):
    cipher, tag = sealed[:-16], sealed[-16:]
    if len(sealed) < 16 or not hmac.compare_digest(_mac(key, nonce, aad, cipher), tag):
        raise RuntimeError("a sealed answer did not check out (changed on the way, or the wrong key)")
    return _chacha(key, 1, nonce, cipher)


# Ed25519, the same code as server/waddlemesh/ed25519.py.
_ED_L = 2**252 + 27742317777372353535851937790883648493
_ED_D = -121665 * pow(121666, _P - 2, _P) % _P
_ED_SQRT_M1 = pow(2, (_P - 1) // 4, _P)


def _ed_add(p, q):
    x1, y1, z1, t1 = p
    x2, y2, z2, t2 = q
    a = (y1 - x1) * (y2 - x2) % _P
    b = (y1 + x1) * (y2 + x2) % _P
    c = 2 * t1 * t2 * _ED_D % _P
    d = 2 * z1 * z2 % _P
    e, f, g, h = b - a, d - c, d + c, b + a
    return e * f % _P, g * h % _P, f * g % _P, e * h % _P


def _ed_mul(s, p):
    out = (0, 1, 1, 0)
    while s:
        if s & 1:
            out = _ed_add(out, p)
        p = _ed_add(p, p)
        s >>= 1
    return out


def _ed_x(y, sign):
    if y >= _P:
        return None
    x2 = (y * y - 1) * pow(_ED_D * y * y + 1, _P - 2, _P) % _P
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P:
        x = x * _ED_SQRT_M1 % _P
    if (x * x - x2) % _P:
        return None
    return _P - x if (x & 1) != sign else x


_ED_GY = 4 * pow(5, _P - 2, _P) % _P
_ED_G = (_ed_x(_ED_GY, 0), _ED_GY, 1, _ed_x(_ED_GY, 0) * _ED_GY % _P)


def _ed_encode(p):
    zi = pow(p[2], _P - 2, _P)
    x, y = p[0] * zi % _P, p[1] * zi % _P
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def _ed_decode(b):
    y = int.from_bytes(b, "little")
    sign, y = y >> 255, y & ((1 << 255) - 1)
    x = _ed_x(y, sign)
    return None if x is None else (x, y, 1, x * y % _P)


def _ed_hash(*parts):
    return int.from_bytes(hashlib.sha512(b"".join(parts)).digest(), "little")


def _ed_expand(seed):
    h = hashlib.sha512(seed).digest()
    a = (int.from_bytes(h[:32], "little") & ((1 << 254) - 8)) | (1 << 254)
    return a, h[32:]


def ed25519_public(seed):
    return _ed_encode(_ed_mul(_ed_expand(seed)[0], _ED_G))


def ed25519_sign(seed, message):
    a, prefix = _ed_expand(seed)
    public = _ed_encode(_ed_mul(a, _ED_G))
    r = _ed_hash(prefix, message) % _ED_L
    big_r = _ed_encode(_ed_mul(r, _ED_G))
    s = (r + _ed_hash(big_r, public, message) * a) % _ED_L
    return big_r + s.to_bytes(32, "little")


def ed25519_verify(public, message, signature):
    if len(public) != 32 or len(signature) != 64:
        return False
    a, r = _ed_decode(public), _ed_decode(signature[:32])
    s = int.from_bytes(signature[32:], "little")
    if a is None or r is None or s >= _ED_L:
        return False
    left = _ed_mul(s, _ED_G)
    right = _ed_add(r, _ed_mul(_ed_hash(signature[:32], public, message) % _ED_L, a))
    return (left[0] * right[2] - right[0] * left[2]) % _P == 0 and (left[1] * right[2] - right[1] * left[2]) % _P == 0


def setup_key(tool_secret, tool_public, unit_public):
    shared = x25519(tool_secret, unit_public)
    return hashlib.blake2b(shared + tool_public + unit_public, digest_size=32).digest()


def setup_nonce(n):
    """Nonce for what is sealed outside packets: the byte, then 11 zeros.
    1: a unit's sender key, 2: to the unit in setup, 3: a join request, 4: a welcome."""
    return bytes([n]) + bytes(11)


def six_digits(data):
    n = int.from_bytes(hashlib.blake2b(data, digest_size=32).digest()[:3], "big") % 1000000
    return "%03d %03d" % (n // 1000, n % 1000)


def pair_commit(tool_public, tool_nonce):
    return hashlib.blake2b(tool_public + tool_nonce, digest_size=32).digest()


def pair_code(tool_public, unit_public, tool_nonce, unit_nonce):
    """The six digits the unit shows on its File Transfer screen. The tool
    commits to its key and nonce before it sees the unit's nonce, so nobody on
    the Wi-Fi can choose a key that gives the same digits."""
    return six_digits(tool_public + unit_public + tool_nonce + unit_nonce)


def join_key(shared, password, unit_public, admin_public):
    """K = BLAKE2b-256(X25519 || password || unit public || admin public).
    shared is X25519(admin secret, unit public), the same as the unit's side."""
    return hashlib.blake2b(shared + password + unit_public + admin_public, digest_size=32).digest()


def join_code(admin_public, unit_public):
    """The six digits the newcomer's unit shows, from both public keys."""
    return six_digits(admin_public + unit_public)


# --- Roster and ROSTER packets (protocol/PROTOCOL.md, "The roster") -------------------


def fit_name(name):
    """At most 20 bytes of UTF-8, not cut inside a letter."""
    return name.strip().encode()[:NAME_MAX].decode(errors="ignore")


def read_roster(data, admin_sign=None):
    """{network, version, members: [{number, admin, name, public, tokenHash}]}; the
    signature is checked when admin_sign is given."""
    if len(data) < 5 + 64 or data[0] != 1:
        raise RuntimeError("not a roster")
    body = data[:-64]
    if admin_sign is not None and not ed25519_verify(admin_sign, body, data[-64:]):
        raise RuntimeError("the roster is not signed by the admin")
    roster = {"network": body[1], "version": struct.unpack_from("<H", body, 2)[0], "members": []}
    i = 5
    for _ in range(body[4]):
        number, flags, size = body[i:i + 3]
        i += 3
        if not 1 <= number <= MAX_MEMBERS or size > NAME_MAX or i + size + 48 > len(body):
            raise RuntimeError("a broken roster")
        roster["members"].append({"number": number, "admin": bool(flags & 1),
                                  "name": body[i:i + size].decode(errors="replace"),
                                  "public": body[i + size:i + size + 32],
                                  "tokenHash": body[i + size + 32:i + size + 48]})
        i += size + 48
    if i != len(body):
        raise RuntimeError("a broken roster")
    return roster


def write_roster(roster, sign_seed):
    """The signed bytes, like writeRoster() in MeshRoster.cpp."""
    out = struct.pack("<BBHB", 1, roster["network"], roster["version"], len(roster["members"]))
    for m in roster["members"]:
        name = fit_name(m["name"]).encode()
        out += bytes([m["number"], 1 if m["admin"] else 0, len(name)]) + name + m["public"] + m["tokenHash"]
    return out + ed25519_sign(sign_seed, out)


def header(ptype, network, sender, recipient, counter, index=0, count=1, hops=3):
    """A 14-byte packet header (protocol/PROTOCOL.md, "Header"); no group id, key number 0."""
    return bytes([0x57, (4 << 4) | ptype, network, (hops & 0x0F) | (0x10 if count > 1 else 0), sender,
                  recipient]) + struct.pack("<IBHB", counter, (index << 4) | count, 0, 0)


def packet_aad(h):
    return h[0:3] + h[4:10] + h[11:14]


def packet_nonce(h):
    """Sender, recipient, counter, type, then 5 zeros."""
    return h[4:10] + bytes([h[1] & 0x0F]) + bytes(5)


ROSTER_TYPE = 7
MAX_PIECE = 186  # 200-byte packets minus the header
MAX_PIECES = 15


def roster_packets(network_key, network, version, signed):
    """The signed roster as ROSTER packets: sender 0 (server), to everyone, counter
    0x40000000 + version, sealed with the network key once and cut into pieces
    (like seal() in MeshCrypto.cpp)."""
    counter = 0x40000000 + version
    count = -(-(len(signed) + 16) // MAX_PIECE)
    if count > MAX_PIECES:
        raise RuntimeError("the roster is too long for ROSTER packets")
    h = header(ROSTER_TYPE, network, 0, 0xFF, counter, 0, count)
    run = aead_seal(network_key, packet_nonce(h), signed, packet_aad(h))
    return [header(ROSTER_TYPE, network, 0, 0xFF, counter, i, count) + run[i * MAX_PIECE:(i + 1) * MAX_PIECE]
            for i in range(count)]


# --- Invitation links -------------------------------------------------------------


def make_link(network, invite, password, admin_box, cert_hash, url):
    raw = bytes([network]) + invite + password + admin_box + cert_hash + url.encode()
    return "waddle://join/" + base64.urlsafe_b64encode(raw).decode().rstrip("=")


def read_link(link):
    link = link.strip()
    if not link.startswith("waddle://join/"):
        raise RuntimeError("not an invitation link (it starts with waddle://join/)")
    data = link[len("waddle://join/"):]
    try:
        raw = base64.urlsafe_b64decode(data + "=" * (-len(data) % 4))
    except ValueError as e:
        raise RuntimeError("the invitation link is broken: copy all of it") from e
    if len(raw) < 1 + 8 + 16 + 32 + 32 + 9:
        raise RuntimeError("the invitation link is too short: copy all of it")
    return {"network": raw[0], "invite": raw[1:9], "password": raw[9:25], "adminBox": raw[25:57],
            "certHash": raw[57:89], "url": raw[89:].decode()}


def cert_hash(pem):
    return hashlib.sha256(ssl.PEM_cert_to_DER_cert(pem)).digest()


# --- Talking to units, the Pi and the server -------------------------------------------


def say(text=""):
    print(text, flush=True)


def ask(prompt, default=""):
    shown = f"{prompt} {DIM}[{default}]{N}: " if default else f"{prompt}: "
    answer = input(shown).strip()
    return answer or default


def yes(prompt):
    return ask(f"{prompt} (y/n)", "y").lower().startswith(("y", "j"))


def unit_get(ip, path):
    with urllib.request.urlopen(f"http://{ip}{path}", timeout=8) as r:
        return json.load(r)


def unit_post(ip, path, data):
    req = urllib.request.Request(f"http://{ip}{path}", data=json.dumps(data).encode(), method="POST",
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.read().decode()
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"{ip} said: {e.read().decode(errors='replace')}") from e


def ssh(host, command):
    run = subprocess.run(["ssh", host, command], capture_output=True, text=True)
    if run.returncode:
        raise RuntimeError(f"on {host}: {(run.stdout + run.stderr).strip() or 'failed'}")
    return run.stdout


def server_request(url, cert_sha256, method, path, doc=None):
    """HTTPS to the Pi, trusting only the certificate whose SHA-256 the invitation
    carries (it is self-made, so no authority vouches for it). (status, JSON or None)."""
    u = urllib.parse.urlsplit(url)
    if u.scheme != "https":
        raise RuntimeError(f"the server address must start with https:// ({url})")
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE  # checked below, against the invitation
    conn = http.client.HTTPSConnection(u.hostname, u.port or 443, context=ctx, timeout=20)
    try:
        conn.connect()
        if not hmac.compare_digest(hashlib.sha256(conn.sock.getpeercert(binary_form=True)).digest(), cert_sha256):
            raise RuntimeError(f"{url} is not the server in the invitation (another certificate). Stopped")
        body = json.dumps(doc).encode() if doc is not None else None
        conn.request(method, u.path.rstrip("/") + path, body=body, headers={"Content-Type": "application/json"})
        r = conn.getresponse()
        data = r.read()
        try:
            return r.status, json.loads(data) if data else None
        except ValueError:
            return r.status, None
    finally:
        conn.close()


def load(path):
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        return json.load(f)


def save(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(doc, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def need_admin():
    cfg = load(ADMIN)
    if not cfg:
        raise RuntimeError(f"no network on this computer ({ADMIN}): run `waddle mesh setup` first")
    return cfg


def current_roster(cfg):
    if cfg.get("roster"):
        return read_roster(bytes.fromhex(cfg["roster"]), ed25519_public(bytes.fromhex(cfg["signSeed"])))
    return {"network": cfg["network"], "version": 0, "members": []}


def remember_unit(name, ip, number=None):
    """Units set up from this computer, so `check` can ask them."""
    mesh = load(MESH)
    units = [u for u in mesh.get("units", []) if u["ip"] != ip and (number is None or u.get("number") != number)]
    units.append({"name": name, "ip": ip, "number": number})
    mesh["units"] = units
    save(MESH, mesh)


def hand_over(ip, link, name):
    """Gives the unit the invitation, sealed for it alone (POST /api/mesh/join).
    Returns (its public key, its sealed request, the code it shows)."""
    tool_secret, tool_nonce = secrets.token_bytes(32), secrets.token_bytes(16)
    tool_public = x25519_public(tool_secret)
    ident = unit_get(ip, "/api/mesh/identity?commit=" + pair_commit(tool_public, tool_nonce).hex())
    if "nonce" not in ident:
        raise RuntimeError(f"the unit at {ip} has older firmware: update it first (waddle update)")
    unit_public, unit_nonce = bytes.fromhex(ident["publicKey"]), bytes.fromhex(ident["nonce"])
    unit_post(ip, "/api/mesh/pair", {"tool": tool_public.hex(), "nonce": tool_nonce.hex()})
    # Someone on the Wi-Fi could pretend to be the unit and learn the invitation:
    # the same code on the unit's own screen shows nothing sits between.
    code = pair_code(tool_public, unit_public, tool_nonce, unit_nonce)
    if not yes(f"  Does the unit's screen show the setup code {B}{code}{N}?"):
        raise RuntimeError(f"the code does not match: something else answered at {ip}. Stopped")
    key = setup_key(tool_secret, tool_public, unit_public)
    sealed = aead_seal(key, setup_nonce(2), json.dumps({"invite": link, "name": name}).encode())
    answer = json.loads(unit_post(ip, "/api/mesh/join", {"tool": tool_public.hex(), "box": sealed.hex()}))
    if bytes.fromhex(answer["from"]) != unit_public:
        raise RuntimeError(f"{ip} answered with another key than it showed. Stopped")
    return unit_public, bytes.fromhex(answer["box"]), answer.get("code", "")


def open_request(cfg, invite, unit_public, box):
    """The newcomer's {"name"} and the join key K, or RuntimeError."""
    secret = bytes.fromhex(cfg["boxSecret"])
    password = bytes.fromhex(cfg["invites"][invite]["password"])
    k = join_key(x25519(secret, unit_public), password, unit_public, x25519_public(secret))
    return json.loads(aead_open(k, setup_nonce(3), box)), k


def admit(cfg, pi, newcomers):
    """Lets newcomers in: each gets the lowest free number and a server token; one
    new roster is signed and put on the Pi with its ROSTER packets. Returns the
    sealed welcome per invitation. newcomers: [{invite, public, name, key}]."""
    roster = current_roster(cfg)
    first = not roster["members"]
    now = int(time.time())
    for i, n in enumerate(newcomers):
        if any(m["public"] == n["public"] for m in roster["members"]):
            raise RuntimeError(f"{n['name']}'s unit is in the network already (`waddle mesh remove` it first)")
        free = [x for x in range(1, MAX_MEMBERS + 1) if x not in {m["number"] for m in roster["members"]}]
        if not free:
            raise RuntimeError(f"the network is full ({MAX_MEMBERS} members)")
        # Someone taken out and invited again (a lost phone or unit) gets their
        # old number back, so their chats stay in one place on every unit.
        # Others get the lowest number nobody had, while one is left.
        invited = cfg["invites"].get(n["invite"], {}).get("name", "").lower()
        former = cfg.get("former", {}).get(invited)
        unused = [x for x in free if x not in cfg.get("former", {}).values()]
        number = former if former in free else (unused or free)[0]
        if number == former:
            cfg["former"].pop(invited)
        n["number"], n["token"] = number, secrets.token_hex(16)
        # The first unit of a new network is the admin's own.
        roster["members"].append({"number": number, "admin": first and i == 0, "name": n["name"],
                                  "public": n["public"],
                                  "tokenHash": hashlib.sha256(n["token"].encode()).digest()[:16]})
    roster["members"].sort(key=lambda m: m["number"])
    signed = upload_roster(cfg, pi, roster)
    sign_seed, box_secret = bytes.fromhex(cfg["signSeed"]), bytes.fromhex(cfg["boxSecret"])
    welcomes = {}
    for n in newcomers:
        doc = {"network": cfg["network"], "me": n["number"], "name": fit_name(n["name"]),
               "networkKey": cfg["networkKey"], "adminSign": ed25519_public(sign_seed).hex(),
               "adminBox": x25519_public(box_secret).hex(),
               "server": {"url": cfg["url"], "cert": cfg["cert"], "token": n["token"]},
               # Message counters start above this, so a unit taking a former
               # member's number never repeats their counters.
               "counterFloor": now, "roster": signed.hex()}
        welcomes[n["invite"]] = aead_seal(n["key"], setup_nonce(4), json.dumps(doc).encode())
        # Kept until it reached the unit or the Pi (welcome_sent), so a failed
        # upload can be tried again: the newcomer is in the roster already.
        cfg["invites"][n["invite"]]["welcome"] = welcomes[n["invite"]].hex()
    save(ADMIN, cfg)
    return welcomes


def welcome_sent(cfg, invite):
    cfg["invites"].pop(invite, None)
    save(ADMIN, cfg)


def send_kept_welcomes(cfg, pi):
    """Welcomes made earlier that did not reach the Pi: tried again."""
    for invite, inv in list(cfg.get("invites", {}).items()):
        if inv.get("welcome"):
            ssh(pi, f"{PI_CMD} welcome {invite} {inv['welcome']}")
            welcome_sent(cfg, invite)
            say(f"  {G}✓{N} {inv['name']}'s welcome is on the Pi now")


def upload_roster(cfg, pi, roster):
    """Signs roster as the next version and puts it on the Pi; saves it here too."""
    roster["version"] += 1
    signed = write_roster(roster, bytes.fromhex(cfg["signSeed"]))
    packets = roster_packets(bytes.fromhex(cfg["networkKey"]), cfg["network"], roster["version"], signed)
    ssh(pi, f"{PI_CMD} set-roster {signed.hex()} {' '.join(p.hex() for p in packets)}")
    cfg["roster"] = signed.hex()
    save(ADMIN, cfg)
    return signed


def new_invitation(cfg, name):
    invite, password = secrets.token_bytes(8), secrets.token_bytes(16)
    cfg.setdefault("invites", {})[invite.hex()] = {"name": name, "password": password.hex(), "made": int(time.time())}
    save(ADMIN, cfg)
    return invite.hex(), make_link(cfg["network"], invite, password,
                                   x25519_public(bytes.fromhex(cfg["boxSecret"])), cert_hash(cfg["cert"]), cfg["url"])


# --- Commands: the admin ------------------------------------------------------------


def setup(args):
    say(f"\n{B}🐧 waddle mesh setup{N}\n")
    cfg, mesh = load(ADMIN), load(MESH)
    if cfg:
        roster = current_roster(cfg)
        say(f"{DIM}Network {cfg['network']} exists, with {len(roster['members'])} members. "
            f"Adding more of your own units.{N}\n")
    else:
        say("This makes a new network. Its keys stay on this computer, in " + ADMIN)
        say(f"\n{C}▸{N} The Pi server (it stores and passes on messages; it cannot read them)")
        pi = ask("Pi over SSH, e.g. pi@raspberrypi.local", mesh.get("pi", ""))
        if not pi:
            raise RuntimeError("the network needs the Pi")
        url = ask("Address units use, from home and away (router forwards port 8443)", "https://").rstrip("/")
        cert = ssh(pi, "sudo cat /var/lib/waddlemesh/cert.pem")
        if "BEGIN CERTIFICATE" not in cert:
            raise RuntimeError("no certificate on the Pi: run server/install.sh there first")
        sign_seed = secrets.token_bytes(32)
        cfg = {"network": secrets.randbelow(255) + 1, "signSeed": sign_seed.hex(),
               "boxSecret": secrets.token_bytes(32).hex(), "networkKey": secrets.token_bytes(32).hex(),
               "url": url, "cert": cert, "roster": "", "invites": {}}
        ssh(pi, f"{PI_ROOT_CMD} set-network {cfg['network']} {ed25519_public(sign_seed).hex()}"
                " && sudo systemctl restart waddlemesh")
        save(ADMIN, cfg)
        mesh["pi"] = pi
        save(MESH, mesh)
        say(f"  {G}✓{N} Network {cfg['network']} made; the server knows your key")
        say(f"  {Y}Keep a copy of {ADMIN} somewhere safe:{N} without it nobody new can join.")

    say(f"\nOn each of your own units: {B}File Transfer -> Join a Network{N}. Each shows its address.")
    newcomers = []
    while len(newcomers) + len(current_roster(cfg)["members"]) < MAX_MEMBERS:
        ip = ask(f"\nUnit {len(newcomers) + 1}: address on its screen (empty = done)")
        if not ip:
            break
        name = fit_name(ask(f"Unit {len(newcomers) + 1}: name"))
        if not name:
            raise RuntimeError("a unit needs a name")
        invite, link = new_invitation(cfg, name)
        try:
            unit_public, box, _ = hand_over(ip, link, name)
            request, k = open_request(cfg, invite, unit_public, box)
        except BaseException:
            cfg["invites"].pop(invite)
            save(ADMIN, cfg)
            raise
        newcomers.append({"invite": invite, "public": unit_public, "name": request.get("name") or name,
                          "key": k, "ip": ip})
        say(f"  {G}✓{N} {name}: key {unit_public.hex()[:16]}…")
    if not newcomers:
        say()
        return 0

    say(f"\n{C}▸{N} Signing the new member list and giving it to the Pi")
    welcomes = admit(cfg, load(MESH).get("pi") or ask("Pi over SSH"), newcomers)
    for n in newcomers:
        unit_post(n["ip"], "/api/mesh/welcome", {"box": welcomes[n["invite"]].hex()})
        welcome_sent(cfg, n["invite"])
        remember_unit(n["name"], n["ip"], n["number"])
        say(f"  {G}✓{N} {n['name']} is member {n['number']}")
    say(f"\n{G}{B}🐧 Done!{N} Close File Transfer on each unit; they find each other over LoRa.")
    say(f"Someone new: {B}waddle mesh invite <name>{N}.\n")
    return 0


def invite(args):
    if not args:
        raise RuntimeError("who is it for? waddle mesh invite <name>")
    cfg = need_admin()
    name = fit_name(" ".join(args))
    _, link = new_invitation(cfg, name)
    say(f"\n{B}🐧 An invitation for {name}{N}\n")
    say(f"Send {name} this link (Signal is good; anyone with it can join once):\n")
    say(f"  {B}{link}{N}\n")
    say(f"{name}: put your unit on File Transfer -> Join a Network, then on a computer on the same Wi-Fi:")
    say(f"  curl -sfLO https://raw.githubusercontent.com/{REPO}/waddle/tools/waddle-mesh")
    say(f"  python3 waddle-mesh join '{link}'")
    say(f"\nThen let them in with {B}waddle mesh approve{N}.\n")
    return 0


def approve(args):
    cfg = need_admin()
    pi = load(MESH).get("pi") or ask("Pi over SSH")
    say(f"\n{B}🐧 waddle mesh approve{N}\n")
    send_kept_welcomes(cfg, pi)
    waiting = json.loads(ssh(pi, f"{PI_CMD} joins") or "[]")
    if not waiting:
        say("Nobody is waiting.\n")
        return 0
    admin_box = x25519_public(bytes.fromhex(cfg["boxSecret"]))
    newcomers = []
    for req in waiting:
        inv = cfg.get("invites", {}).get(req["invite"])
        try:
            if not inv or inv.get("welcome"):
                raise RuntimeError("an unknown or used invitation")
            unit_public = bytes.fromhex(req["from"])
            request, k = open_request(cfg, req["invite"], unit_public, bytes.fromhex(req["box"]))
        except (RuntimeError, ValueError, KeyError) as e:
            say(f"  {R}✗{N} A request that does not open ({e}): forgotten")
            ssh(pi, f"{PI_CMD} forget {shlex.quote(req['invite'])}")
            continue
        name = fit_name(request.get("name") or inv["name"])
        say(f"Invitation for {B}{inv['name']}{N}: the unit calls itself {B}{name}{N}, "
            f"code {B}{join_code(admin_box, unit_public)}{N}")
        say(f"  {DIM}(the same six digits show on their unit; compare on the phone if you like){N}")
        if yes(f"  Let {name} in?"):
            newcomers.append({"invite": req["invite"], "public": unit_public, "name": name, "key": k})
        else:
            ssh(pi, f"{PI_CMD} forget {req['invite']}")
            cfg["invites"].pop(req["invite"], None)
            save(ADMIN, cfg)
            say("  Not let in; that invitation is used up. Make a new one if it was them.")
    if not newcomers:
        say()
        return 0
    welcomes = admit(cfg, pi, newcomers)
    for n in newcomers:
        ssh(pi, f"{PI_CMD} welcome {n['invite']} {welcomes[n['invite']].hex()}")
        welcome_sent(cfg, n["invite"])
        say(f"  {G}✓{N} {n['name']} is member {n['number']}; their unit starts within 10 seconds")
    say()
    return 0


def find_member(roster, who):
    who = who.strip()
    found = [m for m in roster["members"] if m["name"].lower() == who.lower() or str(m["number"]) == who]
    if len(found) != 1:
        names = ", ".join(f"{m['number']} {m['name']}" for m in roster["members"])
        raise RuntimeError(f"no single member called {who!r} (members: {names}); give the number instead")
    return found[0]


def remove(args):
    if not args:
        raise RuntimeError("who? waddle mesh remove <name or number>")
    cfg = need_admin()
    roster = current_roster(cfg)
    gone = find_member(roster, " ".join(args))
    say(f"\n{B}🐧 waddle mesh remove{N}\n")
    say(f"{gone['name']} (member {gone['number']}) is taken out. The other units make new keys and leave")
    say("them out of every group, so their unit cannot open anything new.")
    if not yes("Go on?"):
        return 1
    roster["members"] = [m for m in roster["members"] if m["number"] != gone["number"]]
    # An invitation in the same name later gives them this number again.
    cfg.setdefault("former", {})[gone["name"].lower()] = gone["number"]
    upload_roster(cfg, load(MESH).get("pi") or ask("Pi over SSH"), roster)
    mesh = load(MESH)
    mesh["units"] = [u for u in mesh.get("units", []) if u.get("number") != gone["number"]]
    save(MESH, mesh)
    say(f"  {G}✓{N} Member list version {roster['version']} is on the Pi; units get it at their next check.")
    say(f"  Their unit makes new keys when it gets it. To let them back (same number, same chats):")
    say(f"  {B}waddle mesh invite {gone['name']}{N}\n")
    return 0


def members(args):
    cfg = need_admin()
    roster = current_roster(cfg)
    say(f"\n{B}🐧 Network {cfg['network']}{N}, member list version {roster['version']}\n")
    for m in roster["members"]:
        admin = f" {DIM}(admin){N}" if m["admin"] else ""
        say(f"  {m['number']:>2}  {m['name']}{admin}  {DIM}{m['public'].hex()[:16]}…{N}")
    if not roster["members"]:
        say("  nobody yet: waddle mesh setup")
    waiting = cfg.get("invites", {})
    if waiting:
        say(f"\n  Invitations not used yet: {', '.join(i['name'] for i in waiting.values())}")
    say()
    return 0


# --- Commands: the newcomer -----------------------------------------------------------


def join(args):
    name = args[args.index("--name") + 1] if "--name" in args else None
    links = [a for a in args if a.startswith("waddle://")]
    if not links:
        raise RuntimeError("give the link: waddle mesh join 'waddle://join/…'")
    inv = read_link(links[0])
    say(f"\n{B}🐧 waddle mesh join{N}  {DIM}(server {inv['url']}){N}\n")
    name = fit_name(name or ask("Your name, as the others see it"))
    if not name:
        raise RuntimeError("a name is needed")
    say(f"On your unit: {B}File Transfer -> Join a Network{N} (same Wi-Fi as this computer).")
    ip = ask("Address on the unit's screen")
    unit_public, box, code = hand_over(ip, links[0], name)
    if code and code != join_code(inv["adminBox"], unit_public):
        raise RuntimeError("the unit's code does not match the invitation. Stopped")
    say(f"  {G}✓{N} The unit has the invitation. Code: {B}{join_code(inv['adminBox'], unit_public)}{N}")
    say(f"    {DIM}(your unit shows it too, and so does the admin's screen when they let you in){N}")

    request = {"invite": inv["invite"].hex(), "from": unit_public.hex(), "box": box.hex()}
    status, _ = server_request(inv["url"], inv["certHash"], "POST", "/api/join", request)
    if status == 409:
        say(f"  {Y}The server has a request for this invitation already{N} (from an earlier try?). Waiting for it.")
    elif status == 429:
        raise RuntimeError("the server has too many waiting requests: try again tomorrow")
    elif status != 200:
        raise RuntimeError(f"the server said {status}")
    else:
        say(f"  {G}✓{N} Asked to join")
    remember_unit(name, ip)

    say(f"\nWaiting for the admin to let you in (asks every {POLL_S} s; Ctrl+C to stop, the unit")
    say("keeps the invitation, so run this again later). Keep the unit on File Transfer.")
    while True:
        try:
            status, answer = server_request(inv["url"], inv["certHash"], "GET", f"/api/join/{inv['invite'].hex()}")
        except OSError as e:  # the Wi-Fi or the Pi away for a moment: ask again
            say(f"  {DIM}no answer from the server ({e}); trying again{N}")
            status, answer = 404, None
        if status == 200 and answer and answer.get("box"):
            break
        if status != 404:
            raise RuntimeError(f"the server said {status}")
        time.sleep(POLL_S)
    unit_post(ip, "/api/mesh/welcome", {"box": answer["box"]})
    say(f"\n{G}{B}🐧 You are in!{N} Close File Transfer; your unit finds the others over LoRa.\n")
    return 0


# --- A new unit ---------------------------------------------------------------


def esptool():
    """The esptool command, as a list, or an error that says how to get it."""
    for name in ("esptool", "esptool.py"):
        if shutil.which(name):
            return [name]
    if subprocess.run([sys.executable, "-m", "esptool", "version"], capture_output=True).returncode == 0:
        return [sys.executable, "-m", "esptool"]
    raise RuntimeError("esptool is missing. Arch: sudo pacman -S esptool · macOS: brew install esptool · "
                       "anywhere: pipx install esptool")


def fetch_image(name, tag):
    say(f"{C}▸{N} Getting {name} ({tag}) from github.com/{REPO}")
    try:
        with urllib.request.urlopen(f"https://api.github.com/repos/{REPO}/releases/tags/{tag}", timeout=15) as r:
            release = json.load(r)
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"no {tag} release on GitHub ({e.code})") from e
    asset = next((a for a in release.get("assets", []) if a["name"] == name), None)
    if not asset:
        raise RuntimeError(f"no {name} in the {tag} release yet (has the build finished?)")
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, f"{tag}-{name}")
    with urllib.request.urlopen(asset["browser_download_url"], timeout=120) as r, open(path, "wb") as f:
        shutil.copyfileobj(r, f)
    say(f"  {G}✓{N} {asset['size'] // 1024} KB")
    return path


def read_serial(port, seconds):
    """Lines the device prints on USB for a few seconds (Linux and macOS, no pyserial)."""
    import termios  # not on Windows
    fd = os.open(port, os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        attrs = termios.tcgetattr(fd)
        attrs[0] = attrs[1] = attrs[3] = 0  # raw: no input, output or local processing
        attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
        attrs[4] = attrs[5] = termios.B115200
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        data, end = b"", time.time() + seconds
        while time.time() < end:
            try:
                data += os.read(fd, 1024)
            except BlockingIOError:
                time.sleep(0.1)
        return data.decode(errors="replace").splitlines()
    finally:
        os.close(fd)


def find_port():
    for pattern in ("/dev/ttyACM", "/dev/ttyUSB", "/dev/cu.usbmodem"):
        folder, prefix = os.path.split(pattern)
        try:
            ports = sorted(f for f in os.listdir(folder) if f.startswith(prefix))
        except OSError:
            continue
        if ports:
            return os.path.join(folder, ports[0])
    return None


AIRTIME_BUDGET_MS = 216000  # a unit's own limit per rolling hour (6 %)


def unit_health(ip, logs=False):
    """What a unit says about itself, as (ok, text). The diagnostics page
    (/api/mesh/diag) has no keys and no message text."""
    try:
        status = unit_get(ip, "/api/status")
        ident = unit_get(ip, "/api/mesh/identity")
    except (OSError, ValueError) as e:
        return False, f"no answer ({e})"
    try:
        diag = unit_get(ip, "/api/mesh/diag")
    except (OSError, ValueError):
        diag = {}  # older firmware
    problems = []
    if status.get("board") != "t5s3":
        problems.append(f"board is {status.get('board')!r}, not t5s3")
    if not ident.get("radio"):
        problems.append("radio did not start")
    if status.get("rolledBack"):
        problems.append("its last update crashed and was undone")
    if diag:
        if not diag.get("sd"):
            problems.append("no SD card (or it does not work)")
        if not diag.get("clockSet"):
            problems.append("its clock is not set (no GPS fix or server contact yet)")
        if diag.get("crashReport"):
            problems.append("it crashed once: crash_report.txt is on its SD card")
        if diag.get("resetReason") in ("BROWNOUT", "PANIC (exception/abort)", "CPU_LOCKUP", "TASK_WDT", "INT_WDT"):
            problems.append(f"it last restarted because of {diag['resetReason']}")
        if diag.get("heapLargest", 1 << 20) < 40000:
            problems.append(f"little free memory ({diag['heapLargest'] // 1024} KB in one piece)")
    parts = [ident.get("version") or status.get("version", "?"),
             "radio OK" if ident.get("radio") else "radio FAILED",
             f"GPS {ident.get('gps', '?')}", f"battery {ident.get('battery', '?')} %",
             f"member {ident['me']} ({ident.get('name')})" if ident.get("configured") else "not set up"]
    text = " · ".join(parts)
    if diag:
        hours = diag.get("uptimeS", 0) // 3600
        text += (f"\n    {DIM}up {hours} h (started by {diag.get('resetReason', '?')}) · "
                 f"airtime {100 * diag.get('airtimeMs', 0) // AIRTIME_BUDGET_MS} % of its limit · "
                 f"waiting to send {diag.get('outbox', 0)}, to be confirmed {diag.get('pending', 0)} · "
                 f"server {diag.get('server', '?')}{N}")
        if logs and diag.get("logs"):
            text += "\n" + "\n".join("    " + line for line in diag["logs"].splitlines())
    return not problems, text + ("".join(f"\n    {R}✗{N} {p}" for p in problems))


def new_unit(args):
    device = "gateway" if "gateway" in args else "t5"
    port = args[args.index("--port") + 1] if "--port" in args else None
    pr = args[args.index("--pr") + 1] if "--pr" in args else None
    files = [a for a in args if a.endswith(".bin")]
    say(f"\n{B}🐧 waddle mesh new-unit{N} ({'gateway, Heltec V4' if device == 'gateway' else 'mesh unit, LilyGO T5'})\n")
    tool = esptool()
    image = files[0] if files else fetch_image(FULL_IMAGES[device], f"pr-{pr}" if pr else "waddle-latest")
    port = port or find_port()
    if not port:
        raise RuntimeError("no device on USB. Plug it in (hold BOOT while plugging in if it is not found)")
    say(f"\n{Y}This writes the whole flash of the device on {port}:{N} a unit gets new keys and must")
    say("join the network again. The SD card is not touched.")
    if not yes("Go on?"):
        return 1
    say(f"{C}▸{N} Flashing (about a minute)")
    subprocess.run([*tool, "--chip", "esp32s3", "--port", port, "--baud", "921600", "write_flash", "0x0", image],
                   check=True)
    say(f"  {G}✓{N} Flashed")

    if device == "gateway":
        say(f"{C}▸{N} Listening for the gateway")
        time.sleep(2)
        hello = [l for l in read_serial(port, 8) if l.startswith("HELLO waddle-gateway")]
        if not hello:
            raise RuntimeError("the gateway did not say HELLO (press its RST button and run `waddle mesh check`)")
        say(f"  {G}✓{N} {hello[0]}")
        say(f"\n{G}{B}🐧 Done!{N} Plug the gateway into the Pi.\n")
        return 0

    say(f"\nOn the unit: the penguin, then Hjem. Open {B}Meldinger{N} and tap the text to start")
    say("File Transfer, join your Wi-Fi, and type the address it shows here.")
    ip = ask("Address")
    ok, text = unit_health(ip)
    say(f"  {G if ok else R}{'✓' if ok else '✗'}{N} {text}")
    if not ok:
        return 1
    say(f"\nNext: {B}waddle mesh setup{N} (your own unit) or {B}waddle mesh join <link>{N} (an invitation).\n")
    return 0


def check(args):
    """Asks every unit set up from this computer how it is."""
    units = load(MESH).get("units", [])
    if not units:
        raise RuntimeError("no units set up from this computer yet: `waddle mesh setup` or `join` first")
    say(f"\n{B}🐧 waddle mesh check{N}  {DIM}(each unit on File Transfer → Join a Network){N}\n")
    bad = 0
    for m in units:
        ok, text = unit_health(m["ip"], logs="--logs" in args)
        bad += not ok
        say(f"  {G if ok else R}{'✓' if ok else '✗'}{N} {B}{m['name']}{N} {DIM}{m['ip']}{N}: {text}")
    say()
    return 1 if bad else 0


def server_update(args):
    """Puts the newest server code on the Pi (or a PR's), installs and checks it."""
    pr = args[args.index("--pr") + 1] if "--pr" in args else None
    pi = ask("Pi over SSH", load(MESH).get("pi", ""))
    if not pi:
        raise RuntimeError("no Pi given")
    ref = f"refs/pull/{pr}/head" if pr else "refs/heads/waddle"
    say(f"\n{B}🐧 waddle mesh server{N} → {pi}  {DIM}({ref}){N}\n")
    say(f"{C}▸{N} Downloading and installing")
    ssh(pi, "set -e; d=$(mktemp -d); "
            f"curl -sfL https://codeload.github.com/{REPO}/tar.gz/{ref} | "
            "tar xz -C \"$d\" --strip-components=1 --wildcards '*/server'; "
            "sudo bash \"$d/server/install.sh\" >/dev/null; rm -rf \"$d\"")
    say(f"  {G}✓{N} Installed")
    time.sleep(3)
    status = json.loads(ssh(pi, "curl -sk https://localhost:8443/api/status"))
    gw = status.get("gateway") or {}
    gw_text = f"answering, version {gw.get('version')}" if gw.get("answering") else "not answering"
    say(f"  {G}✓{N} Running · gateway {gw_text} · {len(status.get('units', []))} units")
    say()
    return 0


COMMANDS = {"setup": setup, "invite": invite, "join": join, "approve": approve, "remove": remove,
            "members": members, "new-unit": new_unit, "check": check, "server": server_update}


def main(argv):
    if argv and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:])
    say(__doc__)
    return 0 if not argv or argv[0] in ("-h", "--help", "help") else 1


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        say("\nStopped.")
        sys.exit(130)
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.CalledProcessError) as e:
        say(f"\n{R}✗{N} {e}")
        sys.exit(1)
