# Regenerate from the repository root with:
#   python3 freeink-sdk/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/core/components/icons/readerToolbarIcons.manifest \
#     --svgdir freeink-sdk/libs/assets/Icons/lucide/icons \
#     --sizes 24 --out src/core/components/icons/readerToolbarIcons.h
reader-contents = menu
reader-text = type
reader-more = ellipsis
reader-back = chevron-left
reader-next = chevron-right
